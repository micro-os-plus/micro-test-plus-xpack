  "cdlComponents": [
    {
      "id": "test.unit",
      "display": "Unit Test",
      "description": "The source code for a single program with all the unit tests that can be linked together, for platforms with large memory",
      "sourceFiles": [
        "src/main.cpp"
      ],
      "dependencies": [
        "test.unit-checks.body",
        "test.unit-combinations.body",
        "test.unit-exceptions.body",
        "test.unit-miscellaneous.body"
      ]
    }
  ]
}
