  "cdlComponents": [
    {
      "id": "tests.unit-deprecated",
      "display": "Deprecated Unit Test",
      "description": "The source code for a unit test to exercise the deprecated features of the test framework",
      "publicIncludeFolders": [
        "include"
      ],
      "sourceFiles": [
        "src/main.cpp",
        "src/deprecated.cpp",
        "src/support.cpp"
      ],
      "dependencies": [
        "micro-os-plus.micro-test-plus.static-library"
      ]
    }
  ]
}
