{
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 Liviu Ionescu. All rights reserved.",
  "cdlComponents": [
    {
      "id": "test.unit-miscellaneous",
      "display": "Miscellaneous Unit Test",
      "description": "The source code for a unit test to exercise the miscellaneous features of the test framework",
      "sourceFiles": [
        "src/main.cpp"
      ],
      "cdlComponents": [
        {
          "id": "body",
          "display": "Miscellaneous Unit Test Body",
          "description": "The test code of the miscellaneous unit test, without main()",
          "publicIncludeFolders": [
            "include"
          ],
          "sourceFiles": [
            "src/miscellaneous.cpp",
            "src/runner-options.cpp",
            "src/stopwatch.cpp",
            "src/utility.cpp",
            "src/allocations.cpp"
          ],
          "dependencies": [
            "micro-os-plus.micro-test-plus.static-library",
            "test.unit-common"
          ]
        }
      ]
    }
  ]
}
