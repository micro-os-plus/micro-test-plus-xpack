{
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 Liviu Ionescu. All rights reserved.",
  "cdlComponents": [
    {
      "id": "benchmark.footprint-googletest",
      "display": "Footprint GoogleTest",
      "description": "The footprint benchmark program of GoogleTest",
      "publicIncludeFolders": [
        "../../../../benchmarks-frameworks/googletest/googletest/include",
        "../../../../benchmarks-frameworks/googletest/googletest"
      ],
      "sourceFiles": [
        "src/main.cpp",
        "../../../../benchmarks-frameworks/googletest/googletest/src/gtest-all.cc"
      ],
      "publicDefines": [
        "GTEST_HAS_PTHREAD=0"
      ],
      "publicCompilerOptions": [
        "-w"
      ],
      "dependencies": [
        "benchmark.footprint-common"
      ]
    }
  ]
}