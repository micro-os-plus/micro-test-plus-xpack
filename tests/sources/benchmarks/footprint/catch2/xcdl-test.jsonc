{
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 Liviu Ionescu. All rights reserved.",
  "cdlComponents": [
    {
      "id": "benchmark.footprint-catch2",
      "display": "Footprint Catch2",
      "description": "The footprint benchmark program of Catch2",
      "publicIncludeFolders": [
        "../../../../benchmarks-frameworks/catch2/extras"
      ],
      "sourceFiles": [
        "src/main.cpp",
        "../../../../benchmarks-frameworks/catch2/extras/catch_amalgamated.cpp"
      ],
      "publicDefines": [
        // On macOS, `_POSIX_C_SOURCE` hides the BSD types used by
        // `<sys/sysctl.h>`; the other C libraries ignore this macro.
        "_DARWIN_C_SOURCE",
        "CATCH_CONFIG_NO_POSIX_SIGNALS"
      ],
      "publicCompilerOptions": [
        "-w"
      ],
      "dependencies": [
        "benchmark.footprint-common"
      ]
    }
  ]
}