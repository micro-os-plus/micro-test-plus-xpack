// The testing frameworks compared by the benchmark programs, fetched by
// `scripts/fetch-benchmarks-frameworks.mjs` into `benchmarks-frameworks/`.
//
// Each git entry gives the release tag and the commit it is expected to
// resolve to; the script stops with an error if the tag was moved. The
// archive entries give the version, the SHA-256 checksum of the archive,
// and the folder extracted from it.
//
// When a framework is updated, also update the Sources table of the
// comparison page (website/docs/getting-started/comparison/index.mdx).
{
  "unity": {
    "git": "https://github.com/ThrowTheSwitch/Unity.git",
    "tag": "v2.7.0",
    "commit": "b6763fbd9cedfacaa89e2ad9fd00d615a234e355"
  },
  // CppUTest has had no release since v4.0 (2020-05-27).
  "cpputest": {
    "git": "https://github.com/cpputest/cpputest.git",
    "tag": "v4.0",
    "commit": "67d2dfd41e13f09ff218aa08e2d35f1c32f032a1"
  },
  "doctest": {
    "git": "https://github.com/doctest/doctest.git",
    "tag": "v2.5.3",
    "commit": "2d0a9359a60c51affe2a9bebb1be1dca47868151"
  },
  "catch2": {
    "git": "https://github.com/catchorg/Catch2.git",
    "tag": "v3.16.1",
    "commit": "08092139210881f01a34e60c5f2fd6afa0ea4024"
  },
  "boost-ut": {
    "git": "https://github.com/boost-ext/ut.git",
    "tag": "v2.3.1",
    "commit": "f923e6fe4b7542d75e0c4ee54ad0af6a5382a87c"
  },
  "googletest": {
    "git": "https://github.com/google/googletest.git",
    "tag": "v1.18.0",
    "commit": "063de7e9578f82b369302001269680b4b1553359"
  },
  // The `snitch/snitch_config.hpp` header is generated by the snitch CMake
  // configuration, with the default options.
  "snitch": {
    "git": "https://github.com/snitch-org/snitch.git",
    "tag": "v1.3.2",
    "commit": "cec4a04b776f74455573acc6913a73bcd84c8844"
  },
  // Boost.Test is used in its single-header variant, which needs only the
  // Boost headers; Boost is not a single git repository, so the headers are
  // extracted from the release archive.
  "boost": {
    "archive": "https://archives.boost.io/release/1.92.0/source/boost_1_92_0.tar.bz2",
    "version": "1.92.0",
    "sha256": "5c1d40cb8e19adbf740a4ec2da35b3e58f3f5804b1dce44deb53df72193cbc6c",
    "extract": "boost_1_92_0/boost"
  }
}