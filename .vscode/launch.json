      "executable": "${workspaceRoot}/tests/build/nucleo-h533re-cmake-gcc-debug/suite-test.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      // https://review.openocd.org/c/openocd/+/9913
      "serverpath": "/Users/ilg/.local/st-openocd/bin/openocd",
      "gdbPath": "${workspaceRoot}/tests/build/nucleo-h533re-cmake-gcc-debug/xpacks/.bin/arm-none-eabi-gdb",
