        "adapter speed 5000"
      ]
    },
    {
      // Trial alternative to the cortex-debug entry above, for the same
      // empty-test binary: cppdbg (Microsoft C/C++ extension) drives GDB
      // directly via generic GDB-MI, with no ARM-specific logic in its
      // Disassembly view, unlike cortex-debug (see the "disassembly does
      // not display the instructions" discussion). OpenOCD is started
      // separately as a plain GDB server by the "preLaunchTask" (left
      // running with its GDB port open), instead of cortex-debug's own
      // single-shot "program ... verify ... reset" flow.
      "name": "(cppdbg) raspberry-pi-pico-2-riscv-cmake-gcc-debug empty-test",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceRoot}/tests/build/raspberry-pi-pico-2-riscv-cmake-gcc-debug/empty-test.elf",
      "cwd": "${workspaceRoot}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceRoot}/tests/build/raspberry-pi-pico-2-riscv-cmake-gcc-debug/xpacks/.bin/riscv-none-elf-gdb",
      "preLaunchTask": "openocd-raspberry-pi-pico-2-riscv-cmake-gcc-debug",
      "setupCommands": [
        {
          "text": "target extended-remote localhost:3333"
        },
        {
          "text": "file \"${workspaceRoot}/tests/build/raspberry-pi-pico-2-riscv-cmake-gcc-debug/empty-test.elf\""
        },
        {
          "text": "set mem inaccessible-by-default off",
          "ignoreFailures": true
        },
        {
          "text": "monitor reset init"
        },
        {
          "text": "monitor arm semihosting enable"
        },
        {
          "text": "monitor arm semihosting_cmdline empty-test one two --output-file empty-test.tap"
        },
        {
          "text": "load"
        },
        {
          "text": "break _reset_handler"
        },
        {
          "text": "break _debugger_entry_point"
        },
        {
          "text": "break main"
        }
        // No further "monitor reset init" here: "load" above already
        // leaves PC at the ELF's entry point (_debugger_entry_point, per
        // the linker's ENTRY() directive), which is what
        // "_debugger_entry_point"'s own code re-enters the boot ROM for.
        // A real hardware reset instead goes through the boot ROM's own
        // picobin ENTRY_POINT handling, which is not yet validated on
        // this platform (see device/README.md) and was observed to skip
        // past the _reset_handler/_debugger_entry_point breakpoints
        // straight to main.
      ],
      // MIEngine inserts any editor/gutter breakpoints (and function
      // breakpoints) after setupCommands finish, then runs this command.
      // Do NOT resume manually inside setupCommands (that would run
      // before those breakpoints are inserted, silently skipping any set
      // via the editor rather than via "break ..." above) or use
      // "exec-run" (a remote target already connected via "target
      // extended-remote" rejects it: "remote target does not support
      // run").
      "launchCompleteCommand": "exec-continue"
    },
