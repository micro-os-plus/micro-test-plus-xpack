      "serverArgs": [
        "-s",
        "/Users/ilg/.local/st-openocd/openocd/scripts"
      ],
      "svdFile": "${workspaceRoot}/tests/platforms/nucleo-h533re/device/STM32H533.svd",
      "runToEntryPoint": "main",
      // Halt (do not reset) before loading: the flash may currently hold a
      // blank/stale image whose vector table is invalid, and resetting into
      // it faults immediately (CPU lockup, "clearing lockup after double
      // fault"). Only reset once the valid ELF has been flashed.
      "overrideLaunchCommands": [
        "monitor halt",
        "monitor arm semihosting enable",
        "monitor arm semihosting_cmdline suite-test one two --output-file suite-test.tap",
        "load \"${workspaceRoot}/tests/build/nucleo-h533re-cmake-gcc-debug/suite-test.elf\"",
        "monitor reset init",
        "break Reset_Handler"
      ],
      "openOCDLaunchCommands": [
