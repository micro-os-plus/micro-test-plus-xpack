    {
      "name": "raspberry-pi-pico-cmake-gcc-debug empty-test",
      "cwd": "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
      "executable": "${workspaceRoot}/tests/build/raspberry-pi-pico-cmake-gcc-debug/empty-test.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "serverpath": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd.exe",
      "gdbPath": "${workspaceRoot}/tests/build/raspberry-pi-pico-cmake-gcc-debug/xpacks/.bin/arm-none-eabi-gdb",
      "debuggerArgs": [
        "-ex",
        "set debug-file-directory /debug"
      ],
      "device": "RP2040",
      "configFiles": [
        "interface/cmsis-dap.cfg",
        "target/rp2040.cfg"
      ],
      "svdFile": "${userHome}/.pico-sdk/sdk/2.3.0/src/rp2040/hardware_regs/RP2350.svd",
      "runToEntryPoint": "main",
      // Fix for no_flash binaries, where monitor reset halt doesn't do what is expected
      // Also works fine for flash binaries
      "overrideLaunchCommands": [
        "monitor reset init",
        "monitor arm semihosting enable",
        "monitor arm semihosting_cmdline empty-test one two --output-file empty-test.tap",
        "load \"${workspaceRoot}/tests/build/raspberry-pi-pico-cmake-gcc-debug/empty-test.elf\"",
        "break Reset_Handler",
        // "break crt0.S:547"
      ],
      "openOCDLaunchCommands": [
        "adapter speed 5000"
      ]
    },
