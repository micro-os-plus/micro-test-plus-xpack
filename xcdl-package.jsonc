{
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2022-2026 Liviu Ionescu. All rights reserved.",
  "cdlComponents": [
    {
      "id": "micro-os-plus.micro-test-plus",
      "display": "µTest++ Testing Framework",
      "description": "µTest++, a lightweight testing framework for embedded platforms",
      "publicIncludeFolders": [
        "include"
      ],
      "sourceFiles": [
        "src/runner.cpp",
        "src/runner-totals.cpp",
        "src/deferred-reporter.cpp",
        "src/expression-formatter.cpp",
        "src/reporter.cpp",
        "src/reporter-human.cpp",
        "src/reporter-tap.cpp",
        "src/test.cpp",
        "src/timings.cpp",
        "src/reflection.cpp",
        "src/utility.cpp"
      ],
      "dependencies": [
        "micro-os-plus.diag.trace"
      ],
      "generatedFile": {
        "type": "header",
        "filePath": "{{buildFolderPath}}/generated/include/micro-os-plus/micro-test-plus-defines.h"
      },
      // "$customDefine": "MICRO_OS_PLUS_MICRO_TEST_PLUS_ENABLED",
      "cdlOptions": [
        {
          "id": "trace",
          "display": "Enable trace in µTest++",
          "description": "Display trace messages in the µTest++ Testing Framework when TRACE is enabled",
          "requires": "isEnabled('micro-os-plus.diag.trace')",
          "defaultValue": false
          // "$customDefine": "MICRO_OS_PLUS_MICRO_TEST_PLUS_TRACE_ENABLED"
        },
        {
          "id": "trace-constructors",
          "display": "Enable trace in constructors and destructors in µTest++",
          "description": "Display trace messages in constructors and destructors in the µTest++ Testing Framework when TRACE is enabled",
          "requires": "isEnabled('trace')"
          // "$customDefine": "MICRO_OS_PLUS_MICRO_TEST_PLUS_TRACE_CONSTRUCTORS_ENABLED"
        }
      ],
      "cdlArtefacts": [
        {
          "id": "static-library",
          "display": "Static Library",
          "description": "Static library with the µTest++ Testing Framework",
          "type": "staticLibrary",
          "fileName": "micro-test-plus",
          "dependencies": [
            "micro-os-plus.micro-test-plus"
          ]
        },
        {
          "id": "objects-library",
          "display": "Object Files",
          "description": "Object files with the µTest++ Testing Framework",
          "type": "objectFiles",
          "folderName": "micro-test-plus",
          "dependencies": [
            "micro-os-plus.micro-test-plus"
          ]
        }
      ]
    }
  ]
}