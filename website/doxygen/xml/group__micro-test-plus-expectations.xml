  <compounddef id="group__micro-test-plus-expectations" kind="group">
    <compoundname>micro-test-plus-expectations</compoundname>
    <title>Expectations</title>
    <sectiondef kind="func">
      <memberdef kind="function" id="group__micro-test-plus-expectations_1ga75c3f43663a5440d78231fe572fe4a22" prot="public" static="no" constexpr="yes" const="no" explicit="no" inline="no" virt="non-virtual">
        <templateparamlist>
          <param>
            <type>class Expr_T</type>
          </param>
          <param>
            <type>type_traits::requires_t&lt; type_traits::is_op_v&lt; Expr_T &gt; or type_traits::is_convertible_v&lt; Expr_T, bool &gt; &gt;</type>
            <defval>0</defval>
          </param>
