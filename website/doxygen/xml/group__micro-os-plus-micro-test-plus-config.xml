  <compounddef id="group__micro-os-plus-micro-test-plus-config" kind="group">
    <compoundname>micro-os-plus-micro-test-plus-config</compoundname>
    <title>Configuration</title>
    <sectiondef kind="define">
      <memberdef kind="define" id="group__micro-os-plus-micro-test-plus-config_1ga3dd1e70998580fe7d7f410e5cd83879b" prot="public" static="no">
        <name>MICRO_OS_PLUS_MICRO_TEST_PLUS_ENABLED</name>
        <briefdescription>
<para>Enables the µTest++ Testing Framework. </para>
        </briefdescription>
        <detaileddescription>
<para>Must be defined by the application, in <computeroutput>micro-os-plus/project-config.h</computeroutput>, in <computeroutput>micro-os-plus/micro-test-plus-defines.h</computeroutput>, or on the compiler command line. Without it, <computeroutput><ref refid="micro-test-plus_8h" kindref="compound">micro-os-plus/micro-test-plus.h</ref></computeroutput> declares nothing and the library sources compile to nothing.  </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="/Users/ilg/MyProjects/micro-os-plus.github/xPacks/micro-test-plus-xpack.git/include/micro-os-plus/micro-test-plus.h" line="76" column="9" bodyfile="/Users/ilg/MyProjects/micro-os-plus.github/xPacks/micro-test-plus-xpack.git/include/micro-os-plus/micro-test-plus.h" bodystart="76" bodyend="-1"/>
      </memberdef>
      <memberdef kind="define" id="group__micro-os-plus-micro-test-plus-config_1ga27bb1b9066b162d868e0b1c557b91e0d" prot="public" static="no">
        <name>MICRO_OS_PLUS_MICRO_TEST_PLUS_TRACE_CONSTRUCTORS_ENABLED</name>
        <briefdescription>
<para>Enables the trace messages of the µTest++ constructors and destructors. </para>
        </briefdescription>
        <detaileddescription>
<para>Displays trace messages in the constructors and destructors of the µTest++ Testing Framework, through <computeroutput>trace::printf()</computeroutput>, which writes them only when <computeroutput>MICRO_OS_PLUS_DIAG_TRACE_ENABLED</computeroutput> is also defined.   </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="/Users/ilg/MyProjects/micro-os-plus.github/xPacks/micro-test-plus-xpack.git/include/micro-os-plus/micro-test-plus.h" line="78" column="9" bodyfile="/Users/ilg/MyProjects/micro-os-plus.github/xPacks/micro-test-plus-xpack.git/include/micro-os-plus/micro-test-plus.h" bodystart="78" bodyend="-1"/>
      </memberdef>
      <memberdef kind="define" id="group__micro-os-plus-micro-test-plus-config_1ga039219e6edfdcaa8a5e07badd7f4830d" prot="public" static="no">
        <name>MICRO_OS_PLUS_MICRO_TEST_PLUS_TRACE_ENABLED</name>
        <briefdescription>
<para>Enables the trace messages of the µTest++ member functions. </para>
        </briefdescription>
        <detaileddescription>
<para>Displays trace messages in the member functions of the µTest++ Testing Framework, through <computeroutput>trace::printf()</computeroutput>, which writes them only when <computeroutput>MICRO_OS_PLUS_DIAG_TRACE_ENABLED</computeroutput> is also defined.  </para>
        </detaileddescription>
