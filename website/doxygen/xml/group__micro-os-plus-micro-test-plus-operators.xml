</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>Rhs_T</parametername>
</parameternamelist>
<parameterdescription>
<para>Type of the right hand side operand.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>lhs</parametername>
</parameternamelist>
<parameterdescription>
<para>Left hand side operand. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>rhs</parametername>
</parameternamelist>
<parameterdescription>
<para>Right hand side operand. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>A logical conjunction object that evaluates to true if both operands are true. </para>
</simplesect>
</para>
