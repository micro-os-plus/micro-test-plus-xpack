<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/></highlight><highlight class="keywordtype">int</highlight><highlight class="normal">&amp;<sp/>ir,<sp/></highlight><highlight class="keywordtype">int</highlight><highlight class="normal">*<sp/>ip1,<sp/></highlight><highlight class="keywordtype">int</highlight><highlight class="normal">*<sp/>ip2)</highlight></codeline>
<codeline><highlight class="normal">{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>ts.test<sp/>(</highlight><highlight class="stringliteral">&quot;args&quot;</highlight><highlight class="normal">,<sp/>[&amp;]<sp/>(</highlight><highlight class="keyword">auto</highlight><highlight class="normal">&amp;<sp/>t)<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/>t.expect<sp/>(mt::eq<sp/>(ic,<sp/>42))<sp/>&lt;&lt;<sp/></highlight><highlight class="stringliteral">&quot;ic<sp/>is<sp/>42&quot;</highlight><highlight class="normal">;</highlight></codeline>
