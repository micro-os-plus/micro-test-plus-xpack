    <title>Assumptions</title>
    <sectiondef kind="func">
      <memberdef kind="function" id="group__micro-test-plus-assumptions_1ga0346721eb94564ebce4a49ee81c020c8" prot="public" static="no" const="no" explicit="no" inline="yes" virt="non-virtual">
