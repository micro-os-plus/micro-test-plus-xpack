@defgroup micro-os-plus-micro-test-plus-test-suites Test Suites
@brief Test suites are named groups of related test cases.

@details
By default, all test cases defined in `main()` are included in the
top-level test suite, which is owned by the runner and returned by
`runner::initialise()`; its test cases run immediately. For more complex
projects, additional test suites can be defined, typically in separate
source files.

The additional test suites are either added in `main()` with
`runner::add_suite()`, or defined as `mt::static_suite` objects, at
namespace scope, constructed with a name, a reference to the runner, and a
callable (usually a function or a lambda with a `mt::suite&` first
parameter, which creates the test cases), along with any optional
arguments. The static suites register themselves in their constructors,
so they are included in the test run without other calls.

@important
The runner referred to by the static suites in other source files must
have external linkage (not `static`), and be declared `extern` in a
header shared by these files.

The static suites may be constructed before or after the runner, in any
order. All suites, added or static, are run by `runner::run()`, after the
test cases of the top suite, in a single order, sorted by name (byte by
byte, as by `std::strcmp()`); suites with the same name run in the order
in which they were created, so the static ones first. Zero-padded
numeric prefixes (`"01 - Init"`) give an explicit order. Test suites
should nevertheless be designed to be independent of each other.

@par Examples

@code{.cpp}
// In a header shared by the source files.
extern micro_os_plus::micro_test_plus::runner tr;
@endcode

@code{.cpp}
namespace mt = micro_os_plus::micro_test_plus;

// In main.cpp: the runner, with external linkage.
mt::runner tr;

int
main (int argc, char* argv[])
{
  auto& ts = tr.initialise (argc, argv, "Sample");

  ts.test ("Check one", [] (auto& t) {
    t.expect (true) << "Passed";
  });

  return tr.run ();
}
@endcode

@code{.cpp}
namespace mt = micro_os_plus::micro_test_plus;

// In a separate source file: a self-registering suite.
static mt::static_suite ts_extra
    = { "Extra suite", tr, [] (mt::suite& ts) {
  ts.test ("Check two", [] (auto& t) { t.expect (true) << "Passed"; });
} };

// Parametrised test suite accepting additional arguments.
static void
test_suite_with_args (mt::suite& ts, int ic, int iv,
                      int& ir, int* ip1, int* ip2)
{
  ts.test ("args", [&] (auto& t) {
    t.expect (mt::eq (ic, 42)) << "ic is 42";
    t.expect (mt::eq (iv, 43)) << "iv is 43";
    t.expect (mt::eq (ir, 44)) << "ir is 44";
    t.expect (mt::eq (*ip1, 45)) << "*ip1 is 45";
    t.expect (mt::eq (*ip2, 46)) << "*ip2 is 46";
  });
}

static int in = 43;
static int in44 = 44;
static int& ir = in44;
static int in45 = 45;
static int in46 = 46;
static int* ip2 = &in46;

static mt::static_suite ts_args
    = { "Args suite", tr, test_suite_with_args,
        42, in, ir, &in45, ip2 };
@endcode
